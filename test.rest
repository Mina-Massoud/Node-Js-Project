# ============================================================
#   REST Client Test File — Full API Coverage
#   Base URL: http://localhost:5431
#
#   HOW TO USE:
#   1. Install the "REST Client" extension in VS Code
#   2. Click "Send Request" above any request block
#   3. After login, copy the token from the response into
#      @adminToken or @userToken below
#   4. After creating a category/product/order, copy the _id
#      into the matching variable below
# ============================================================

@baseUrl    = http://localhost:5431
@adminToken = PASTE_ADMIN_TOKEN_HERE
@userToken  = PASTE_USER_TOKEN_HERE
@categoryId = PASTE_CATEGORY_ID_HERE
@productId  = PASTE_PRODUCT_ID_HERE
@orderId    = PASTE_ORDER_ID_HERE


# ================================================================
#  MODULE 1 — USERS
# ================================================================

### 1-1  Register a new admin user
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "firstName": "Admin",
  "lastName": "User",
  "email": "admin@test.com",
  "password": "Admin@1234",
  "age": 30,
  "phone": "01000000001",
  "address": "Cairo",
  "role": "admin"
}

###

### 1-2  Register a regular user
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "firstName": "Regular",
  "lastName": "User",
  "email": "user@test.com",
  "password": "User@1234",
  "age": 25,
  "phone": "01000000002",
  "address": "Giza"
}

###

### 1-3  Login as admin  →  copy token into @adminToken above
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Admin@1234"
}

###

### 1-4  Login as regular user  →  copy token into @userToken above
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "User@1234"
}

###

### 1-5  Login — wrong password (expect 401)
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "WRONG"
}

###

### 1-6  Get current user's profile  (requires token)
GET {{baseUrl}}/users/profile
Authorization: Bearer {{adminToken}}

###

### 1-7  Get profile — no token (expect 401)
GET {{baseUrl}}/users/profile

###

### 1-8  Get all users  (admin only)
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

###

### 1-9  Get all users — should fail (user role, expect 403)
GET {{baseUrl}}/users
Authorization: Bearer {{userToken}}

###

### 1-10  Get all users — no token (expect 401)
GET {{baseUrl}}/users


# ================================================================
#  MODULE 2 — CATEGORIES
# ================================================================

### 2-1  Get all categories  (public)
GET {{baseUrl}}/categories

###

### 2-2  Get single category by ID  (public)
GET {{baseUrl}}/categories/{{categoryId}}

###

### 2-3  Get single category — wrong ID (expect 404)
GET {{baseUrl}}/categories/000000000000000000000000

###

### 2-4  Get all products under a specific category  (public)
GET {{baseUrl}}/categories/{{categoryId}}/products

###

### 2-5  Create a category  (admin only)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics",
  "description": "All electronic devices and accessories"
}

###

### 2-6  Create another category
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Books",
  "description": "Educational and fiction books"
}

###

### 2-7  Create category — duplicate name (expect 400)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics"
}

###

### 2-8  Create category — missing name (expect 400)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "description": "No name provided"
}

###

### 2-9  Create category — should fail (user role, expect 403)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Forbidden Category"
}

###

### 2-10  Create category — no token (expect 401)
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "No Token Category"
}

###

### 2-11  Update category  (admin only)
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "description": "Updated description for electronics"
}

###

### 2-12  Update category — wrong ID (expect 404)
PATCH {{baseUrl}}/categories/000000000000000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Ghost Category"
}

###

### 2-13  Delete category  (admin only)
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

###

### 2-14  Delete category — wrong ID (expect 404)
DELETE {{baseUrl}}/categories/000000000000000000000000
Authorization: Bearer {{adminToken}}


# ================================================================
#  MODULE 3 — PRODUCTS
# ================================================================

### 3-1  Get all products  (public)
GET {{baseUrl}}/products

###

### 3-2  Get all products with search, sort, and pagination
GET {{baseUrl}}/products?name=phone&sort=price&page=1&limit=5

###

### 3-3  Get products sorted by price descending
GET {{baseUrl}}/products?sort=-price

###

### 3-4  Get single product by ID  (public)
GET {{baseUrl}}/products/{{productId}}

###

### 3-5  Get single product — wrong ID (expect 404)
GET {{baseUrl}}/products/000000000000000000000000

###

### 3-6  Create a product  (admin only)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "iPhone 15",
  "description": "Apple smartphone with A16 chip",
  "price": 999.99,
  "stock": 50,
  "category": "{{categoryId}}"
}

###

### 3-7  Create a product — missing required fields (expect 400)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "description": "No name or price"
}

###

### 3-8  Create product — should fail (user role, expect 403)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Hacked Product",
  "price": 1,
  "category": "{{categoryId}}"
}

###

### 3-9  Update product  (admin only)
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "price": 899.99,
  "stock": 30
}

###

### 3-10  Update product — wrong ID (expect 404)
PATCH {{baseUrl}}/products/000000000000000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "price": 1
}

###

### 3-11  Delete product  (admin only)
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}

###

### 3-12  Delete product — wrong ID (expect 404)
DELETE {{baseUrl}}/products/000000000000000000000000
Authorization: Bearer {{adminToken}}


# ================================================================
#  MODULE 4 — ORDERS
#  NOTE: prices are looked up server-side from the Product. Do
#  NOT send `price` from the client — it will be ignored.
# ================================================================

### 4-1  Get all orders  (admin sees all)
GET {{baseUrl}}/orders
Authorization: Bearer {{adminToken}}

###

### 4-2  Get my own orders  (regular user sees only their own)
GET {{baseUrl}}/orders
Authorization: Bearer {{userToken}}

###

### 4-3  Get all orders with pagination + status filter
GET {{baseUrl}}/orders?page=1&limit=10&status=pending
Authorization: Bearer {{adminToken}}

###

### 4-4  Get single order by ID
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

###

### 4-5  Get single order — wrong ID (expect 404)
GET {{baseUrl}}/orders/000000000000000000000000
Authorization: Bearer {{adminToken}}

###

### 4-6  Create an order  (authenticated user)
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "items": [
    { "product": "{{productId}}", "quantity": 2 }
  ],
  "shippingAddress": "123 Main St, Cairo"
}

###

### 4-7  Create an order as admin
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "items": [
    { "product": "{{productId}}", "quantity": 1 }
  ],
  "shippingAddress": "Admin HQ"
}

###

### 4-8  Create order — no token (expect 401)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "items": [
    { "product": "{{productId}}", "quantity": 1 }
  ],
  "shippingAddress": "x"
}

###

### 4-9  Create order — empty items (expect 400)
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "items": [],
  "shippingAddress": "x"
}

###

### 4-10  Create order — missing shippingAddress (expect 400)
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "items": [
    { "product": "{{productId}}", "quantity": 1 }
  ]
}

###

### 4-11  Update order status  (admin only — PATCH)
PATCH {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "shipped"
}

###

### 4-12  Update order status — should fail (user role, expect 403)
PATCH {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "status": "delivered"
}

###

### 4-13  Replace whole order  (admin only — PUT)
PUT {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "items": [
    { "product": "{{productId}}", "quantity": 3 }
  ],
  "shippingAddress": "New Address",
  "status": "processing"
}

###

### 4-14  Update status — wrong ID (expect 404)
PATCH {{baseUrl}}/orders/000000000000000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "delivered"
}

###

### 4-15  Delete order  (admin only)
DELETE {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

###

### 4-16  Delete order — should fail (user role, expect 403)
DELETE {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{userToken}}

###

### 4-17  Delete order — wrong ID (expect 404)
DELETE {{baseUrl}}/orders/000000000000000000000000
Authorization: Bearer {{adminToken}}
