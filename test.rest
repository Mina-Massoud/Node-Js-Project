@baseUrl = http://localhost:5431

# ── Paste your tokens here after running the login requests ──
@adminToken = PASTE_ADMIN_TOKEN_HERE
@userToken  = PASTE_USER_TOKEN_HERE

# ── Paste real IDs here after creating records ──
@categoryId = PASTE_CATEGORY_ID_HERE
@productId  = PASTE_PRODUCT_ID_HERE
@orderId    = PASTE_ORDER_ID_HERE
@userId     = PASTE_USER_ID_HERE


# ================================================================
#  MODULE 1 — USERS
# ================================================================

### 1-1  Register a new admin user
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Admin User",
  "email": "admin@test.com",
  "password": "Admin@1234",
  "role": "admin"
}

###

### 1-2  Register a regular user
POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Regular User",
  "email": "user@test.com",
  "password": "User@1234",
  "role": "user"
}

###

### 1-3  Login as admin  →  copy token into @adminToken above
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Admin@1234"
}

###

### 1-4  Login as regular user  →  copy token into @userToken above
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "User@1234"
}

###

### 1-5  Get current user's profile  (requires token)
GET {{baseUrl}}/users/profile
Authorization: Bearer {{adminToken}}

###

### 1-6  Get all users  (admin only)
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

###

### 1-7  Get all users — should fail (user role)
GET {{baseUrl}}/users
Authorization: Bearer {{userToken}}

###

### 1-8  Get all users — should fail (no token)
GET {{baseUrl}}/users


# ================================================================
#  MODULE 2 — CATEGORIES
# ================================================================

### 2-1  Get all categories  (public — no token needed)
GET {{baseUrl}}/categories

###

### 2-2  Get all categories with pagination
GET {{baseUrl}}/categories?page=1&limit=5

###

### 2-3  Get single category by ID  (public)
GET {{baseUrl}}/categories/{{categoryId}}

###

### 2-4  Get single category — wrong ID (expect 404)
GET {{baseUrl}}/categories/000000000000000000000000

###

### 2-5  Get all products under a specific category  (public)
GET {{baseUrl}}/categories/{{categoryId}}/products

###

### 2-6  Create a category  (admin only)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics",
  "description": "All electronic devices and accessories"
}

###

### 2-7  Create another category
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Books",
  "description": "Educational and fiction books"
}

###

### 2-8  Create category — duplicate name (expect 400)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics"
}

###

### 2-9  Create category — missing name (expect 400)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "description": "No name provided"
}

###

### 2-10  Create category — should fail (user role, expect 403)
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "name": "Forbidden Category"
}

###

### 2-11  Create category — should fail (no token, expect 401)
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "No Token Category"
}

###

### 2-12  Update category  (admin only)
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "description": "Updated description for electronics"
}

###

### 2-13  Update category — wrong ID (expect 404)
PATCH {{baseUrl}}/categories/000000000000000000000000
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Ghost Category"
}

###

### 2-14  Delete category  (admin only)
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

###

### 2-15  Delete category — wrong ID (expect 404)
DELETE {{baseUrl}}/categories/000000000000000000000000
Authorization: Bearer {{adminToken}}


